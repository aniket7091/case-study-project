{
	"info": {
		"name": "Customer CRM API",
		"description": "Postman collection for Customer CRM endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Customer CRM Module",
			"item": [
				{
					"name": "1. Create Customer",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"mobile\": \"9876543210\",\n    \"email\": \"john.doe@example.com\",\n    \"business_name\": \"Doe Enterprises\",\n    \"gst_number\": \"27AADCB2230M1Z2\",\n    \"customer_type\": \"RETAIL\",\n    \"address\": \"123, Main Street, City\",\n    \"status\": \"LEAD\",\n    \"follow_up_date\": \"2026-08-15\",\n    \"notes\": \"Initial inquiry\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/customers",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"customers"
							]
						}
					},
					"response": []
				},
				{
					"name": "2. Get All Customers (With Pagination & Filters)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/customers?page=1&limit=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"customers"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "search",
									"value": "John",
									"description": "Search by name, mobile, email or business_name",
									"disabled": true
								},
								{
									"key": "status",
									"value": "LEAD",
									"description": "Filter by status: LEAD, ACTIVE, INACTIVE",
									"disabled": true
								},
								{
									"key": "customer_type",
									"value": "RETAIL",
									"description": "Filter by type: RETAIL, WHOLESALE, DISTRIBUTOR",
									"disabled": true
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "3. Get Customer by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/customers/{{customer_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"customers",
								"{{customer_id}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "4. Update Customer",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"ACTIVE\",\n    \"notes\": \"Converted from lead to active customer.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/customers/{{customer_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"customers",
								"{{customer_id}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "5. Add Follow-up Note",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"note\": \"Discussed wholesale pricing. Call back next week.\",\n    \"follow_up_date\": \"2026-08-20\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/customers/{{customer_id}}/followups",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"customers",
								"{{customer_id}}",
								"followups"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "YOUR_AUTH_TOKEN_HERE",
			"type": "string"
		},
		{
			"key": "customer_id",
			"value": "CUSTOMER_UUID_HERE",
			"type": "string"
		}
	]
}
